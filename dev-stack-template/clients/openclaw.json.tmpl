// OpenClaw config. Rendered to ~/.openclaw/openclaw.json by: just client-configs
// The LiteLLM key is filled in from LITELLM_MASTER_KEY in .env.
{
  models: {
    mode: "merge",
    providers: {
      litellm: {
        baseUrl: "http://127.0.0.1:4000/v1",
        apiKey: "${LITELLM_MASTER_KEY}",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "private-coder",
            name: "Private: Qwen3 Coder Next (Bedrock Sydney)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0.6, output: 1.5, cacheRead: 0, cacheWrite: 0 },  // USD per million tokens
            contextWindow: 256000,
            maxTokens: 16000
          },
          {
            id: "private-general",
            name: "Private: Qwen3 235B (Bedrock Sydney)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0.23, output: 0.91, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 8000
          },
          {
            id: "private-reasoner",
            name: "Private: DeepSeek V3.2 (Bedrock Sydney)",
            reasoning: true,
            input: ["text"],
            cost: { input: 0.64, output: 1.91, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 164000,
            maxTokens: 8000
          },
          {
            id: "open-deepseek",
            name: "Open: DeepSeek V4 Flash via OpenRouter (non-sensitive only)",
            reasoning: false,
            input: ["text"],
            contextWindow: 1000000,
            maxTokens: 8192
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      model: {
        // Inbound messages (WhatsApp etc.) can contain private data: stay on Bedrock.
        primary: "litellm/private-general",
        fallbacks: ["litellm/private-coder"]
      },
      models: {
        "litellm/private-coder": { alias: "Coder" },
        "litellm/private-general": { alias: "General" },
        "litellm/private-reasoner": { alias: "Reasoner" },
        "litellm/open-deepseek": { alias: "Open (public data only)" }
      }
    }
  },

  // channels: {
  //   whatsapp: {
  //     enabled: true,
  //     dmPolicy: "pairing",
  //     allowFrom: ["+15555550123"]
  //   }
  // }
}
