// OpenClaw config. Rendered to ~/.openclaw/openclaw.json by: just client-configs
// The LiteLLM key is filled in from LITELLM_MASTER_KEY in .env.
{
  models: {
    mode: "merge",
    providers: {
      litellm: {
        baseUrl: "http://127.0.0.1:4000/v1",
        apiKey: "${LITELLM_MASTER_KEY}",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "local-coder",
            name: "Local model (llama-server)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,  // match LLAMA_CTX in .env
            maxTokens: 4096
          },
          {
            id: "hybrid-agent",
            name: "Hybrid: local, then cheap open models if local fails",
            reasoning: false,
            input: ["text"],
            contextWindow: 32768,  // the local model's window applies first
            maxTokens: 8192
          },
          {
            id: "open-deepseek",
            name: "DeepSeek V4 Flash via OpenRouter",
            reasoning: false,
            input: ["text"],
            contextWindow: 1000000,
            maxTokens: 8192
          },
          {
            id: "cloud-reasoner",
            name: "Claude Sonnet 5.5 via OpenRouter (paid, capped in LiteLLM)",
            reasoning: true,
            input: ["text"],
            contextWindow: 1000000,
            maxTokens: 8192
          }
        ]
      },
      "llama-local": {
        baseUrl: "http://127.0.0.1:8080/v1",
        apiKey: "none",
        api: "openai-completions",
        timeoutSeconds: 300,
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "local",
            name: "Local model direct (llama-server)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,  // match LLAMA_CTX in .env
            maxTokens: 4096,
            compat: {
              supportsTools: true,
              toolSchemaProfile: "llamacpp"
            }
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      model: {
        primary: "litellm/hybrid-agent",
        // No paid Claude fallback: add "litellm/cloud-reasoner" only if you accept the cost.
        fallbacks: ["litellm/open-deepseek"]
      },
      models: {
        "litellm/local-coder": { alias: "Local" },
        "litellm/hybrid-agent": { alias: "Hybrid" },
        "litellm/open-deepseek": { alias: "DeepSeek" },
        "litellm/cloud-reasoner": { alias: "Claude" }
      }
    }
  },

  // channels: {
  //   whatsapp: {
  //     enabled: true,
  //     dmPolicy: "pairing",
  //     allowFrom: ["+15555550123"]
  //   }
  // }
}
