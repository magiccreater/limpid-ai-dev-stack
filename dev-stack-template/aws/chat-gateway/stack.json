{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sydney Bedrock chat gateway pilot with IAM authorization and a monthly request cap.",
  "Parameters": {
    "MonthlyRequests": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 1,
      "MaxValue": 50,
      "Description": "Maximum Bedrock requests reserved per calendar month in UTC."
    },
    "OpenRouterKeyParameter": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^(|/limpid/chat-gateway/[A-Za-z0-9_-]+)$",
      "Description": "Optional name of a Sydney Standard SecureString containing the public fallback API key."
    }
  },
  "Rules": {
    "SydneyOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-southeast-2"
            ]
          },
          "AssertDescription": "Deploy in Sydney (ap-southeast-2)."
        }
      ]
    }
  },
  "Resources": {
    "Usage": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "month",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "month",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "GatewayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PilotGatewayAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:ap-southeast-2::foundation-model/qwen.qwen3-coder-next"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Usage",
                      "Arn"
                    ]
                  }
                },
                {
                  "Fn::If": [
                    "PublicFallbackEnabled",
                    {
                      "Effect": "Allow",
                      "Action": "ssm:GetParameter",
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${OpenRouterKeyParameter}"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Handler": "index.handler",
        "Runtime": "nodejs22.x",
        "Role": {
          "Fn::GetAtt": [
            "GatewayRole",
            "Arn"
          ]
        },
        "Timeout": 28,
        "MemorySize": 256,
        "Code": {
          "ZipFile": "GENERATED_FROM_GATEWAY_CJS"
        },
        "Environment": {
          "Variables": {
            "USAGE_TABLE": {
              "Ref": "Usage"
            },
            "MONTHLY_REQUESTS": {
              "Ref": "MonthlyRequests"
            },
            "OPENROUTER_KEY_PARAMETER": {
              "Fn::If": [
                "PublicFallbackEnabled",
                {
                  "Ref": "OpenRouterKeyParameter"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          }
        }
      }
    },
    "Api": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-chat"
        },
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        },
        "Policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "execute-api:Invoke",
              "Resource": "execute-api:/*",
              "Condition": {
                "StringNotEquals": {
                  "aws:PrincipalAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "V1": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "Api",
            "RootResourceId"
          ]
        },
        "PathPart": "v1"
      }
    },
    "Chat": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "V1"
        },
        "PathPart": "chat"
      }
    },
    "Completions": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "Chat"
        },
        "PathPart": "completions"
      }
    },
    "ChatPost": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "Completions"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "AWS_IAM",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "ResponseTransferMode": "STREAM",
          "TimeoutInMillis": 29000,
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2021-11-15/functions/${Gateway.Arn}/response-streaming-invocations"
          }
        }
      }
    },
    "AllowGateway": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Gateway"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/pilot/POST/v1/chat/completions"
        }
      }
    },
    "Deployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "DependsOn": [
        "ChatPost",
        "AllowGateway"
      ],
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGateway::Stage",
      "Properties": {
        "StageName": "pilot",
        "RestApiId": {
          "Ref": "Api"
        },
        "DeploymentId": {
          "Ref": "Deployment"
        },
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "DataTraceEnabled": false,
            "ThrottlingRateLimit": 1,
            "ThrottlingBurstLimit": 3
          }
        ]
      }
    }
  },
  "Outputs": {
    "BaseUrl": {
      "Description": "IAM-authenticated OpenAI Chat Completions API base URL.",
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.${AWS::URLSuffix}/pilot/v1"
      }
    }
  },
  "Conditions": {
    "PublicFallbackEnabled": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "OpenRouterKeyParameter"
            },
            ""
          ]
        }
      ]
    }
  }
}
