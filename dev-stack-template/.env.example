# Copy to .env with:  just env
# Values marked __GENERATE__ are replaced with random secrets by scripts/devstack_env.py.
# Never commit .env.

# ============================================================
# OpenRouter (pay per token)
# ============================================================
# Create the key with a credit limit at https://openrouter.ai/settings/keys.
# That limit is the hard stop; the LiteLLM budget in litellm_config.yaml is a second guard.
OPENROUTER_API_KEY=

# ============================================================
# Local model (llama-server, OpenAI-compatible)
# ============================================================
# Windows-native llama-server (recommended) and WSL both use this URL when WSL
# networking is "mirrored" (see .wslconfig.example).
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Preset used by scripts/start_llama_server.sh and scripts/windows/llama-server.ps1:
#   qwen36  - Qwen3.6-35B-A3B Q4_K_M, about 20 GB (best quality; needs most of 32 GB)
#   small   - Qwen2.5-Coder-7B Q4_K_M, about 5 GB (fits easily; weaker at agent work)
LLAMA_PRESET=qwen36
# Context window in tokens. Agent tools (Cline, Aider, OpenClaw) need 32k or more.
LLAMA_CTX=32768
# Keep the experts of this many layers on the CPU if the model does not fit in GPU memory.
LLAMA_N_CPU_MOE=0

# ============================================================
# LiteLLM gateway (listens on 127.0.0.1 only)
# ============================================================
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=__GENERATE__
# Paid frontier models (cloud-reasoner) are refused by shared/devstack_shared/llm.py
# unless this is 1. Use your Claude subscription in Claude Code for interactive work.
ALLOW_FRONTIER=0

# ============================================================
# TypeSafe Jev routing (sends the request text to OpenRouter)
# ============================================================
# 1 = use Jev when OPENROUTER_API_KEY is set; 0 = never call it (agents fall back to
# local defaults). Set 0 when agents handle client or private data.
JEV_ENABLED=1

# ============================================================
# MySQL (bound to 127.0.0.1)
# ============================================================
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_DATABASE=dev_db
MYSQL_USER=dev_user
MYSQL_PASSWORD=__GENERATE__
MYSQL_PORT=3306

# ============================================================
# Local RAG (AnythingLLM, bound to 127.0.0.1)
# ============================================================
ANYTHINGLLM_JWT_SECRET=__GENERATE__

# ============================================================
# OpenClaw
# ============================================================
OPENCLAW_GATEWAY_PORT=18789

# ============================================================
# Optional API keys for agents
# ============================================================
# SERPAPI_KEY=           # trend / research agent
# TWITTER_BEARER_TOKEN=  # social + trend
# POLYGON_API_KEY=       # stock agent
# BRIGHTDATA_API_KEY=    # scraper (optional proxy)
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_ENABLED=false
