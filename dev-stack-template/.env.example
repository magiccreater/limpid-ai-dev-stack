# Copy to .env with:  just env
# Values marked __GENERATE__ are replaced with random secrets by scripts/devstack_env.py.
# Never commit .env.

# ============================================================
# OpenRouter (pay per token)
# ============================================================
# For non-sensitive work only. Create the key with a credit limit at
# https://openrouter.ai/settings/keys, and turn on Zero Data Retention for all models at
# https://openrouter.ai/settings/privacy (litellm_config.yaml also asks for it per request).
OPENROUTER_API_KEY=

# ============================================================
# Amazon Bedrock: private models, Sydney (ap-southeast-2)
# ============================================================
# Access key of the limited IAM user from aws/bedrock-access.yaml (it can only call the
# chosen models in Sydney). Never use your root or admin keys here. See aws/README.md.
# The region is pinned to ap-southeast-2 in litellm_config.yaml, not read from here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# LiteLLM gateway (listens on 127.0.0.1 only)
# ============================================================
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=__GENERATE__
# Paid frontier models (cloud-reasoner) are refused by shared/devstack_shared/llm.py
# unless this is 1. Use your Claude subscription in Claude Code for interactive work.
ALLOW_FRONTIER=0

# ============================================================
# TypeSafe Jev routing (sends the request text to OpenRouter)
# ============================================================
# Off by default because it sends each request's text to OpenRouter. 1 = use Jev when
# OPENROUTER_API_KEY is set (only for agents that never see private data).
JEV_ENABLED=0

# ============================================================
# MySQL (bound to 127.0.0.1)
# ============================================================
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_DATABASE=dev_db
MYSQL_USER=dev_user
MYSQL_PASSWORD=__GENERATE__
MYSQL_PORT=3306

# ============================================================
# Local RAG (AnythingLLM, bound to 127.0.0.1)
# ============================================================
ANYTHINGLLM_JWT_SECRET=__GENERATE__

# ============================================================
# OpenClaw
# ============================================================
OPENCLAW_GATEWAY_PORT=18789

# ============================================================
# Optional API keys for agents
# ============================================================
# SERPAPI_KEY=           # trend / research agent
# TWITTER_BEARER_TOKEN=  # social + trend
# POLYGON_API_KEY=       # stock agent
# BRIGHTDATA_API_KEY=    # scraper (optional proxy)
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_ENABLED=false

# ============================================================
# Free Hosted Open-Source Providers (No hosting needed)
# ============================================================
# GROQ_API_KEY=          # console.groq.com (free ultra-fast Llama 3.3 70B & DeepSeek R1)
# GITHUB_TOKEN=          # github.com/marketplace/models (free DeepSeek R1 & Llama 3.3 70B)
# CEREBRAS_API_KEY=      # cloud.cerebras.ai (1M tokens/day free Llama 3.3 70B)
# SAMBANOVA_API_KEY=     # cloud.sambanova.ai (free Llama 3.1 405B)
