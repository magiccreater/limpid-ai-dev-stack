{
  models: {
    mode: "merge",
    providers: {
      litellm: {
        baseUrl: "http://127.0.0.1:4000/v1",
        apiKey: "sk-dev-proxy-key",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "local-coder",
            name: "Local Qwen Coder (Arc)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 4096,
            maxTokens: 2048
          },
          {
            id: "hybrid-agent",
            name: "Hybrid Local→Open→Frontier",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 128000,
            maxTokens: 8192
          },
          {
            id: "open-deepseek",
            name: "DeepSeek via OpenRouter",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 8192
          },
          {
            id: "cloud-reasoner",
            name: "Claude via OpenRouter",
            reasoning: true,
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 8192
          }
        ]
      },
      "llama-local": {
        baseUrl: "http://127.0.0.1:8080/v1",
        apiKey: "none",
        api: "openai-completions",
        timeoutSeconds: 300,
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "qwen2.5-coder-7b",
            name: "Qwen2.5-Coder-7B direct",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 4096,
            maxTokens: 2048,
            compat: {
              supportsTools: true,
              toolSchemaProfile: "llamacpp"
            }
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      model: {
        primary: "litellm/hybrid-agent",
        fallbacks: ["litellm/open-deepseek", "litellm/cloud-reasoner"]
      },
      models: {
        "litellm/local-coder": { alias: "Local" },
        "litellm/hybrid-agent": { alias: "Hybrid" },
        "litellm/open-deepseek": { alias: "DeepSeek" },
        "litellm/cloud-reasoner": { alias: "Claude" }
      }
    }
  },

  // channels: {
  //   whatsapp: {
  //     enabled: true,
  //     dmPolicy: "pairing",
  //     allowFrom: ["+15555550123"]
  //   }
  // }
}
