# Copy to C:\Users\<YourUsername>\.wslconfig, then run in PowerShell: wsl --shutdown
[wsl2]
# Models run in the cloud (Amazon Bedrock / OpenRouter), so WSL only needs room for
# LiteLLM, Docker (MySQL, AnythingLLM) and the agents. 8 GB leaves the rest of your
# 32 GB to Windows, VS Code and the browser.
memory=8GB
swap=4GB
processors=6

# Windows apps (VS Code, browser) reach services in WSL at 127.0.0.1 (for example
# LiteLLM at 127.0.0.1:4000). This is WSL's default NAT mode; mirrored networking is not
# needed and would expose anything bound to 0.0.0.0 to your network.
localhostForwarding=true

[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
