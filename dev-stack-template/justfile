# Dev Stack justfile — run with: just <recipe>
# Every service listens on 127.0.0.1 only. Nothing here is reachable from your network.

set dotenv-load := true

default:
  @just --list

# ---------- Setup ----------

# Install system packages and tools (WSL Ubuntu)
setup:
  ./setup.sh
  @echo "Run: source ~/.bashrc"

# Create or upgrade .env (generates secrets, replaces published defaults)
env:
  python3 scripts/devstack_env.py init
  @echo "Next: put your OPENROUTER_API_KEY in .env (create it with a credit limit)."

# Write Continue and OpenClaw configs that use your LiteLLM key
client-configs: _check-env
  python3 scripts/devstack_env.py render clients/continue.config.yaml.tmpl ~/.continue/config.yaml
  python3 scripts/devstack_env.py render clients/openclaw.json.tmpl ~/.openclaw/openclaw.json

# ---------- Core services ----------

# LiteLLM gateway on 127.0.0.1:4000
litellm: _check-env
  litellm --config litellm_config.yaml --host 127.0.0.1 --port 4000

mysql: _check-env
  docker compose -f docker/docker-compose.mysql.yml up -d

openclaw:
  openclaw gateway

rag: _check-env
  docker compose -f docker/docker-compose.rag.yml up -d

# Show which ports are open and on which address (0.0.0.0 would mean exposed)
status:
  @echo "=== Listening ports (4000 litellm, 3306 mysql, 3001 rag, 18789 openclaw) ==="
  @ss -tlnH 2>/dev/null | awk '{print $4}' | grep -E ':(4000|3306|3001|18789)$' || echo "none of the stack's ports are open"
  @echo "=== Docker ==="
  @docker ps --format "table {{{{.Names}}\t{{{{.Status}}\t{{{{.Ports}}" 2>/dev/null || echo "docker not running"

# Call models through the gateway and check answers + tool calls (default: the private ones)
check-models *models:
  python3 scripts/check_models.py {{models}}

# Check the stack end to end: env, AWS keys, gateway, exposure
doctor: _check-env
  #!/usr/bin/env bash
  set -uo pipefail
  ok() { echo "  ok   $*"; }; bad() { echo "  FAIL $*"; }
  echo "=== doctor ==="
  [ -n "${OPENROUTER_API_KEY:-}" ] && ok "OPENROUTER_API_KEY set (open models)" || echo "  --   OPENROUTER_API_KEY empty (private models only)"
  [ "${JEV_ENABLED:-0}" = "1" ] && echo "  note JEV_ENABLED=1: agent requests are sent to OpenRouter for routing" || true
  gw_url="${LITELLM_BASE_URL:-http://127.0.0.1:4000/v1}"
  if [ -n "${AWS_ACCESS_KEY_ID:-}" ] && [ -n "${AWS_SECRET_ACCESS_KEY:-}" ]; then ok "AWS keys set (private models: Bedrock Sydney)"; else bad "AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty: private models will fail (see aws/README.md)"; fi
  curl -sf -m 3 -H "Authorization: Bearer $LITELLM_MASTER_KEY" "$gw_url/models" >/dev/null && ok "LiteLLM at $gw_url" || bad "LiteLLM not answering at $gw_url"
  if ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE '^(0\.0\.0\.0|\*|\[::\]):(4000|3306|3001)$'; then bad "a stack port is open on all interfaces (see: just status)"; else ok "no stack port open on all interfaces"; fi

# ---------- Tests ----------

# Unit tests for the shared package and scripts
test:
  uv run --project shared --extra test python -m unittest discover -s tests -v

# ---------- Agents ----------

agent name *args:
  #!/usr/bin/env bash
  set -euo pipefail
  case "{{name}}" in
    coding)     dir=coding-agent ;;
    scraper)    dir=scraper-agent ;;
    social)     dir=social-poster ;;
    trend)      dir=trend-agent ;;
    stock)      dir=stock-agent ;;
    mentor)     dir=mentor-agent ;;
    study)      dir=study-planner ;;
    gatekeeper) dir=gatekeeper-agent ;;
    *) echo "Unknown agent: {{name}}. Use: coding|scraper|social|trend|stock|mentor|study|gatekeeper"; exit 1 ;;
  esac
  cd "examples/$dir" && uv run python agent.py {{args}}

# ---------- Internal ----------

_check-env:
  @python3 scripts/devstack_env.py check
